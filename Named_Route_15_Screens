import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  static const String route1 = '/';
  static const String route2 = '/screen2';
  static const String route3 = '/screen3';
  static const String route4 = '/screen4';
  static const String route5 = '/screen5';
  static const String route6 = '/screen6';
  static const String route7 = '/screen7';
  static const String route8 = '/screen8';
  static const String route9 = '/screen9';
  static const String route10 = '/screen10';
  static const String route11 = '/screen11';
  static const String route12 = '/screen12';
  static const String route13 = '/screen13';
  static const String route14 = '/screen14';
  static const String route15 = '/screen15';

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: '15 Screens Named Routes Demo',
      initialRoute: route1,
      routes: {
        route1: (context) => const Screen1(),
        route2: (context) => const Screen2(),
        route3: (context) => const Screen3(),
        route4: (context) => const Screen4(),
        route5: (context) => const Screen5(),
        route6: (context) => const Screen6(),
        route7: (context) => const Screen7(),
        route8: (context) => const Screen8(),
        route9: (context) => const Screen9(),
        route10: (context) => const Screen10(),
        route11: (context) => const Screen11(),
        route12: (context) => const Screen12(),
        route13: (context) => const Screen13(),
        route14: (context) => const Screen14(),
        route15: (context) => const Screen15(),
      },
    );
  }
}

class NavigationButtons extends StatelessWidget {
  final String title;
  final String? previousRoute;
  final String? nextRoute;

  const NavigationButtons({
    super.key,
    required this.title,
    this.previousRoute,
    this.nextRoute,
  });

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(title), centerTitle: true),
      body: Center(
        child: Padding(
          padding: const EdgeInsets.all(20),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
                title,
                style: const TextStyle(
                  fontSize: 28,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 30),
              if (previousRoute != null)
                ElevatedButton(
                  onPressed: () {
                    Navigator.pushNamed(context, previousRoute!);
                  },
                  child: const Text('Go to Previous Screen'),
                ),
              const SizedBox(height: 15),
              if (nextRoute != null)
                ElevatedButton(
                  onPressed: () {
                    Navigator.pushNamed(context, nextRoute!);
                  },
                  child: const Text('Go to Next Screen'),
                ),
              const SizedBox(height: 15),
              ElevatedButton(
                onPressed: () {
                  Navigator.pop(context);
                },
                child: const Text('Back'),
              ),
              const SizedBox(height: 30),
              ElevatedButton(
                onPressed: () {
                  Navigator.pushNamedAndRemoveUntil(
                    context,
                    MyApp.route1,
                    (route) => false,
                  );
                },
                child: const Text('Go to Home Screen'),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

